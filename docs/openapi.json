            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/tasks/{id}/status": {
      "patch": {
        "tags": [
          "Tasks"
        ],
        "summary": "Change status",
        "description": "Must follow the workflow (TODO -> IN_PROGRESS/BLOCKED, ..., DONE -> TODO/IN_PROGRESS). An illegal move returns 422.",
        "operationId": "changeStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusChangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Status changed",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TaskDto"
                }
              }
